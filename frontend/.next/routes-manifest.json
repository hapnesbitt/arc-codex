{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/article/[slug]",
      "regex": "^/article/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/article/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/about/contact",
      "regex": "^/about/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about/contact(?:/)?$"
    },
    {
      "page": "/about/developer",
      "regex": "^/about/developer(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about/developer(?:/)?$"
    },
    {
      "page": "/about/privacy",
      "regex": "^/about/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about/privacy(?:/)?$"
    },
    {
      "page": "/about/sales",
      "regex": "^/about/sales(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about/sales(?:/)?$"
    },
    {
      "page": "/about/support",
      "regex": "^/about/support(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about/support(?:/)?$"
    },
    {
      "page": "/about/terms",
      "regex": "^/about/terms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about/terms(?:/)?$"
    },
    {
      "page": "/api/user/prefs",
      "regex": "^/api/user/prefs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/user/prefs(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/publish",
      "regex": "^/publish(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/publish(?:/)?$"
    },
    {
      "page": "/search",
      "regex": "^/search(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/search(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}