"use client";

import { useState, useRef, useEffect } from "react";
import { useSession, signIn, signOut } from "next-auth/react";
import { useUserPrefs } from "@/components/UserPrefsContext";
import { Settings, LogOut, Globe, Trash2, X, Check } from "lucide-react";
import { cn } from "@/lib/utils";

const COMMON_LANGUAGES = [
    "Arabic", "Bengali", "Chinese (Simplified)", "Chinese (Traditional)",
    "Dutch", "English", "French", "German", "Greek", "Hindi", "Indonesian",
    "Italian", "Japanese", "Korean", "Malay", "Persian", "Polish",
    "Portuguese", "Russian", "Spanish", "Swahili", "Swedish",
    "Tamil", "Telugu", "Thai", "Turkish", "Ukrainian", "Urdu",
    "Vietnamese",
];

export default function UserMenu() {
    const { data: session, status } = useSession();
    const { prefs, savePreferredLang, deleteAccount } = useUserPrefs();
    const [panelOpen, setPanelOpen] = useState(false);
    const [tempLang, setTempLang] = useState("");
    const [isSaving, setIsSaving] = useState(false);
    const [isSaved, setIsSaved] = useState(false);
    const [confirmDelete, setConfirmDelete] = useState(false);
    const panelRef = useRef<HTMLDivElement>(null);

    // Sync state when panel opens or prefs change
    useEffect(() => {
        if (panelOpen && prefs?.preferred_lang !== undefined) {
            setTempLang(prefs.preferred_lang);
        }
    }, [panelOpen, prefs?.preferred_lang]);

    // Accessibility: Close on outside click or Escape key
    useEffect(() => {
        const handleOutsideClick = (e: MouseEvent) => {
            if (panelRef.current && !panelRef.current.contains(e.target as Node)) {
                setPanelOpen(false);
                setConfirmDelete(false);
            }
        };
        const handleEsc = (e: KeyboardEvent) => {
            if (e.key === "Escape") setPanelOpen(false);
        };

        if (panelOpen) {
            document.addEventListener("mousedown", handleOutsideClick);
            document.addEventListener("keydown", handleEsc);
        }
        return () => {
            document.removeEventListener("mousedown", handleOutsideClick);
            document.removeEventListener("keydown", handleEsc);
        };
    }, [panelOpen]);

    const handleSave = async () => {
        setIsSaving(true);
        try {
            await savePreferredLang(tempLang);
            setIsSaved(true);
            // Briefly show success state then close panel
            setTimeout(() => { 
                setIsSaved(false); 
                setPanelOpen(false); 
            }, 1000);
        } finally {
            setIsSaving(false);
        }
    };

    if (status === "loading") return <div className="h-10 w-10 animate-pulse bg-white/5 rounded-full" />;
    if (!session) return null;

    return (
        <div className="relative px-3 py-2" ref={panelRef}>
            <button 
                onClick={() => setPanelOpen(!panelOpen)} 
                aria-expanded={panelOpen}
                aria-haspopup="true"
                aria-label="User preferences menu"
                className="p-0.5 rounded-full border border-amber-500/30 hover:border-amber-500 transition-all outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
            >
                <img src={session.user?.image ?? ""} className="h-8 w-8 rounded-full" alt="" />
            </button>

            {panelOpen && (
                <div 
                    role="dialog"
                    aria-label="Settings panel"
                    className="absolute left-full ml-4 bottom-0 w-72 bg-[#0a0a0a] border border-white/10 rounded-2xl shadow-2xl z-[100] flex flex-col"
                >
                    {/* Header */}
                    <div className="p-4 border-b border-white/5 bg-white/[0.02]">
                        <p className="text-[10px] uppercase font-black tracking-widest text-amber-500 mb-1">Operator</p>
                        <p className="text-white font-bold truncate text-sm">{session.user?.name}</p>
                    </div>

                    {/* Language Preference Section */}
                    <div className="p-4 space-y-4">
                        <div className="w-full">
                            <label htmlFor="lang-select" className="flex items-center gap-2 text-[10px] uppercase font-bold text-slate-500 mb-2 tracking-wider">
                                <Globe size={12} /> Language
                            </label>
                            <select
                                id="lang-select"
                                value={tempLang}
                                onChange={(e) => setTempLang(e.target.value)}
                                className="w-full bg-black border border-white/10 rounded-lg px-3 py-2 text-xs text-slate-300 focus:border-amber-500/50 outline-none appearance-none cursor-pointer"
                            >
                                <option value="">Auto-detect</option>
                                {COMMON_LANGUAGES.map((l) => <option key={l} value={l}>{l}</option>)}
                            </select>
                        </div>

                        {/* Save Button: Disabled if no change detected */}
                        <div className="flex flex-col w-full pt-1">
                            <button
                                onClick={handleSave}
                                disabled={isSaving || tempLang === (prefs?.preferred_lang ?? "")}
                                className="w-full h-11 px-4 rounded-lg bg-amber-500 text-black font-black text-[10px] uppercase tracking-widest hover:bg-amber-400 disabled:opacity-30 transition-all flex items-center justify-center gap-2 whitespace-nowrap shadow-lg shadow-amber-500/10 active:scale-[0.98]"
                            >
                                {isSaved ? (
                                    <><Check size={14} /> Committed</>
                                ) : isSaving ? (
                                    "..."
                                ) : (
                                    "Save Preference"
                                )}
                            </button>
                        </div>
                    </div>

                    {/* Footer Actions */}
                    <div className="p-2 bg-black/40 border-t border-white/5 flex flex-col gap-1">
                        <button 
                            onClick={() => signOut()} 
                            className="w-full flex justify-between items-center px-3 py-2.5 text-[10px] font-bold uppercase tracking-tighter text-slate-400 hover:text-white hover:bg-white/5 rounded-md transition-all"
                        >
                            Sign Out <LogOut size={14} className="text-amber-500/50" />
                        </button>

                        <button 
                            onClick={async () => confirmDelete ? (await deleteAccount(), signOut()) : setConfirmDelete(true)}
                            className={cn(
                                "w-full flex justify-between items-center px-3 py-2.5 text-[10px] font-bold uppercase tracking-tighter rounded-md transition-all", 
                                confirmDelete ? "bg-red-500/20 text-red-400" : "text-slate-600 hover:text-red-400 hover:bg-red-500/5"
                            )}
                        >
                            <span>{confirmDelete ? "Confirm Purge?" : "Purge Data"}</span>
                            <Trash2 size={14} />
                        </button>
                    </div>
                </div>
            )}
        </div>
    );
}
