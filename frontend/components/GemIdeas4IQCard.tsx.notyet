// Filename: /frontend/components/IntelligenceCard.tsx
// Core Unit: Intelligence Dossier Card
// v8.9 Apr 20 2026 — Comprehensive Type Bypass for Article properties (url, source)

'use client';

import React, { useState, useMemo } from 'react';
import Link from 'next/link';
import { motion } from 'framer-motion';
import { 
  MessageSquare, Clock, ExternalLink, 
  Database, BrainCircuit, Share2, Check,
  ScanLine, ShieldAlert
} from 'lucide-react';
import { Button } from "@/components/ui/button";
import TranslateButton, { TranslatedFields } from '@/components/TranslateButton';
import type { Article, Comment } from '@/lib/types';

// --- INTERNAL COMPONENT: CHIMERA GAUGE ---
const ChimeraGauge = ({ score, size = 40 }: { score: number, size?: number }) => {
  const radius = size * 0.4;
  const center = size / 2;
  const circumference = 2 * Math.PI * radius;
  const offset = circumference - (score / 100) * circumference;

  return (
    <div className="relative flex items-center justify-center" style={{ width: size, height: size }}>
      <svg width={size} height={size} className="transform -rotate-90">
        <circle
          cx={center} cy={center} r={radius}
          stroke="currentColor" strokeWidth="2" fill="transparent"
          className="text-slate-100"
        />
        <circle
          cx={center} cy={center} r={radius}
          stroke="currentColor" strokeWidth="2" fill="transparent"
          strokeDasharray={circumference}
          style={{ strokeDashoffset: offset }}
          className="text-emerald-500 transition-all duration-1000 ease-out"
        />
      </svg>
      <span className="absolute text-[8px] font-mono font-bold text-slate-400">{score}</span>
    </div>
  );
};

interface IntelligenceCardProps {
  card: Article;
  comments?: Comment[];
  isCompact?: boolean;
  initialLang?: string | null;
  defaultExpandedSection?: string;
}

const IntelligenceCard: React.FC<IntelligenceCardProps> = ({ 
  card, 
  comments = [], 
  isCompact = false,
  initialLang = null,
  defaultExpandedSection = ""
}) => {
  const [isCopied, setIsCopied] = useState(false);
  const [translated, setTranslated] = useState<TranslatedFields | null>(null);

  const formattedDate = useMemo(() => {
    return new Date(card.timestamp || Date.now()).toLocaleDateString('en-US', {
      month: 'short', day: '2-digit', year: 'numeric'
    }).toUpperCase();
  }, [card.timestamp]);

  const copyToClipboard = async () => {
    try {
      await navigator.clipboard.writeText(`${window.location.origin}/article/${card.id}`);
      setIsCopied(true);
      setTimeout(() => setIsCopied(false), 2000);
    } catch (err) {
      console.error('Failed to copy', err);
    }
  };

  const handleResetTranslation = () => {
    setTranslated(null);
  };

  const displayTitle = (translated as any)?.title || card.title;
  
  const displaySummary = 
    (translated as any)?.content || 
    (translated as any)?.summary || 
    (card as any).summary || 
    (card as any).content || 
    (card as any).excerpt || 
    "No intelligence summary available.";

  const assessment = (card as any).sentinel?.assessment || 'UNASSESSED';
  const sourceName = (card as any).source_name || (card as any).source || 'UNKNOWN SOURCE';
  const sourceUrl = (card as any).url || (card as any).link || '#';

  return (
    <motion.article 
      initial={{ opacity: 0, y: 10 }}
      animate={{ opacity: 1, y: 0 }}
      className="group relative bg-[#fdfbf7] border border-slate-200 hover:border-slate-900 transition-all duration-500 flex flex-col h-full overflow-hidden"
    >
      {/* I. CLINICAL HEADER */}
      <div className="flex items-center justify-between px-6 py-3 border-b border-slate-100 bg-white/60">
        <div className="flex items-center gap-3">
          <Database className="h-3 w-3 text-slate-400" />
          <span className="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-slate-500 truncate max-w-[150px]">
            {sourceName}
          </span>
        </div>
        
        <div className="flex items-center gap-2">
           <div className={`flex items-center gap-1.5 px-2 py-0.5 border rounded-full ${
             assessment === 'HUMAN' ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-amber-200 bg-amber-50 text-amber-700'
           }`}>
             <ScanLine className="h-2.5 w-2.5" />
             <span className="text-[8px] font-mono font-bold uppercase tracking-widest">
               {assessment}
             </span>
           </div>
        </div>
      </div>

      {/* II. CONTENT BODY */}
      <div className="p-8 flex-grow space-y-6">
        <div className="flex justify-between items-start gap-4">
          <div className="space-y-1">
            <span className="text-[9px] font-mono uppercase tracking-[0.4em] text-blue-600 font-bold">
              {(card as any).directive || "General Intelligence"}
            </span>
            <Link href={`/article/${card.id}`}>
              <h2 className="text-2xl font-bold tracking-tighter leading-tight italic text-slate-900 group-hover:text-blue-800 transition-colors">
                {displayTitle}
              </h2>
            </Link>
          </div>
          
          <div className="shrink-0 pt-1">
            <ChimeraGauge score={(card as any).difficulty_score || 50} />
          </div>
        </div>

        <p className="text-slate-600 text-sm leading-relaxed font-light italic border-l-2 border-slate-100 pl-4 line-clamp-4">
          &ldquo;{displaySummary}&rdquo;
        </p>

        <div className="flex items-center gap-2 pt-2">
          <div className="h-8 text-[9px] font-mono uppercase tracking-widest border border-slate-200 hover:bg-slate-100 transition-colors rounded-full flex items-center px-1">
            <TranslateButton 
              articleId={card.id} 
              onTranslated={setTranslated} 
              onReset={handleResetTranslation}
              cachedLangs={(card as any).cached_langs || []}
              sourceLang={(card as any).language || 'English'}
            />
          </div>

          <Button
            variant="outline"
            size="sm"
            onClick={copyToClipboard}
            className="h-8 w-8 p-0 border-slate-200"
          >
            {isCopied ? <Check className="h-3 w-3 text-emerald-600" /> : <Share2 className="h-3 w-3 text-slate-400" />}
          </Button>
        </div>
      </div>

      {/* III. ANALYSIS TRIAD */}
      <div className="grid grid-cols-3 gap-px bg-slate-200 border-t border-slate-200">
        <AnalysisTab 
          icon={ShieldAlert} 
          label="RED" 
          active={!!(card as any).analysis_red} 
          color="text-rose-600" 
        />
        <AnalysisTab 
          icon={BrainCircuit} 
          label="BLUE" 
          active={!!(card as any).analysis_blue} 
          color="text-blue-600" 
        />
        <AnalysisTab 
          icon={MessageSquare} 
          label="PURPLE" 
          active={!!(card as any).analysis_purple} 
          color="text-purple-600" 
        />
      </div>

      {/* IV. FOOTER */}
      <footer className="px-6 py-4 bg-white flex items-center justify-between border-t border-slate-100">
        <div className="flex items-center gap-4">
          <a 
            href={sourceUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            className="flex items-center gap-2 text-[9px] font-mono uppercase tracking-widest text-slate-400 hover:text-slate-900 transition-colors"
          >
            <ExternalLink className="h-3 w-3" /> Source
          </a>
          {comments.length > 0 && (
            <div className="flex items-center gap-2 text-[9px] font-mono uppercase tracking-widest text-slate-400">
              <MessageSquare className="h-3 w-3" /> {comments.length}
            </div>
          )}
        </div>
        
        <div className="flex items-center gap-2 text-[10px] font-mono text-slate-400">
          <Clock className="h-3 w-3" />
          {formattedDate}
        </div>
      </footer>
    </motion.article>
  );
};

function AnalysisTab({ icon: Icon, label, active, color }: { 
  icon: any, 
  label: string, 
  active: boolean, 
  color: string 
}) {
  return (
    <div className={`flex flex-col items-center justify-center py-4 bg-[#fdfbf7] ${active ? 'opacity-100' : 'opacity-20 grayscale'}`}>
      <Icon className={`h-4 w-4 mb-1 ${active ? color : 'text-slate-400'}`} />
      <span className="text-[8px] font-mono font-bold tracking-[0.2em]">{label}</span>
    </div>
  );
}

export default React.memo(IntelligenceCard);
