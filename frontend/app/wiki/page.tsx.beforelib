// Filename: /frontend/app/wiki/page.tsx
// The Taxonomy of Discourse — A.R.C. Wiki Gateway
// v3.0 Apr 20 2026 — Refined for Epistemic Responsibility

import React from 'react';
import { readFileSync } from 'fs';
import { join } from 'path';
import Link from 'next/link';
import type { Metadata } from 'next';
import { Book, ChevronRight, Hash } from 'lucide-react';

export const metadata: Metadata = {
  title: 'Taxonomy — Arc Codex',
  description: 'A formal classification of intelligence and discourse patterns.',
};

interface DirectiveEntry {
  name: string;
}

interface TopicGroup {
  topic: string;
  directives: DirectiveEntry[];
}

const toSlug = (name: string) =>
  name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

export default function WikiPage() {
  const directivesPath = join(process.cwd(), 'public', 'directives.json');
  const rawGroups: TopicGroup[] = JSON.parse(readFileSync(directivesPath, 'utf-8'));
  const groups = rawGroups.filter(g => g.topic !== 'System Directives');

  return (
    <div className="min-h-screen bg-[#fdfbf7] text-slate-900 font-ubuntu selection:bg-slate-900 selection:text-white">
      <main className="max-w-6xl mx-auto px-6 py-24 md:py-40">
        
        {/* THE PREAMBLE */}
        <header className="max-w-2xl mb-24 space-y-8">
          <div className="flex items-center gap-3 text-slate-400">
            <Book className="h-4 w-4" />
            <span className="text-[10px] font-mono uppercase tracking-[0.4em]">The Great Library</span>
          </div>
          <h1 className="text-6xl md:text-7xl font-bold tracking-tighter leading-none italic">
            The Taxonomy of <br /> 
            <span className="text-slate-400">Discourse.</span>
          </h1>
          <div className="h-px w-24 bg-slate-900" />
          <p className="text-lg text-slate-500 italic leading-relaxed max-w-lg">
            "Intelligence, when properly classified, ceases to be noise and becomes a map of human intent."
          </p>
        </header>

        {/* THE CLASSIFIED GROUPS */}
        <div className="space-y-32">
          {groups.map((group) => (
            <section key={group.topic} className="space-y-12">
              <div className="flex items-end justify-between border-b border-slate-200 pb-4">
                <h2 className="text-sm font-mono uppercase tracking-[0.5em] text-slate-400 font-bold">
                  {group.topic}
                </h2>
                <span className="text-[10px] font-mono text-slate-300">
                  COUNT // {group.directives.length} SPECIMENS
                </span>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-slate-200 border border-slate-200 overflow-hidden">
                {group.directives.map((directive) => (
                  <Link
                    key={directive.name}
                    href={`/wiki/${toSlug(directive.name)}`}
                    className="bg-[#fdfbf7] p-8 group hover:bg-white transition-all duration-500 flex flex-col justify-between min-h-[160px]"
                  >
                    <div className="space-y-3">
                      <div className="flex items-center gap-2 opacity-20 group-hover:opacity-100 transition-opacity">
                        <Hash className="h-3 w-3 text-slate-900" />
                        <span className="text-[8px] font-mono uppercase tracking-widest">A.R.C. Pattern</span>
                      </div>
                      <h3 className="text-xl font-bold italic group-hover:text-slate-900 transition-colors">
                        {directive.name}
                      </h3>
                    </div>
                    
                    <div className="mt-4 flex items-center gap-2 text-[9px] font-mono uppercase tracking-widest text-slate-300 group-hover:text-slate-600 transition-colors">
                      Examine Pattern <ChevronRight className="h-2 w-2" />
                    </div>
                  </Link>
                ))}
              </div>
            </section>
          ))}
        </div>

        {/* FOOTER */}
        <footer className="mt-48 pt-12 border-t border-slate-200 text-center opacity-30">
          <p className="text-[10px] font-mono uppercase tracking-[0.8em]">
            A.R.C. CODEX // DIRECTIVE REGISTRY // 2026
          </p>
        </footer>
      </main>
    </div>
  );
}
