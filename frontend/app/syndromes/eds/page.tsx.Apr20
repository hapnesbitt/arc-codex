import type { Metadata } from 'next';
import Link from 'next/link';
import { BookOpen, Play, GraduationCap, ChevronRight, ExternalLink } from 'lucide-react';

export const metadata: Metadata = {
  title: 'Ehlers-Danlos Syndrome (EDS)',
  description:
    'A curated intelligence unit on Ehlers-Danlos Syndrome — read the Arc Codex analysis, watch condition explainers, and test your understanding with School of Chat.',
