// ---------------------------------------------------------------------------
// Sub-components — keep each section self-contained so cloning is easy
// ---------------------------------------------------------------------------

function SectionHeader({
  icon: Icon,
  label,
  color,
}: {
  icon: React.ElementType;
  label: string;
  color: string;
}) {
  return (
    <div className="flex items-center gap-3 mb-5">
      <div className={`p-2 rounded-lg ${color} bg-opacity-15`}>
        <Icon className={`h-5 w-5 ${color}`} aria-hidden="true" />
      </div>
      <h2 className={`text-lg font-semibold tracking-wide ${color}`}>{label}</h2>
    </div>
  );
}

function ReadSection() {
  return (
    <section
      aria-labelledby="section-read"
      className="bg-slate-900/50 border border-slate-700/60 rounded-2xl p-6 hover:border-amber-500/30 transition-colors"
    >
      <SectionHeader icon={BookOpen} label="Read" color="text-amber-400" />

      <p className="text-slate-300 text-sm leading-relaxed mb-5">
        Ehlers-Danlos Syndrome is a group of connective tissue disorders caused by defects in
        collagen synthesis. The hypermobile subtype (hEDS) is the most common and the only one
        without a confirmed genetic marker — making diagnosis primarily clinical and frequently
        delayed by years.
      </p>

      <a
        href="https://arc-codex.com/article/eb3f80dec719303ff9b53f47d8aac170"
        target="_blank"
