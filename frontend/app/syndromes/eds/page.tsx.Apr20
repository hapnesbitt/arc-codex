                   hover:bg-amber-500/12 transition-all focus-visible:outline-none
                   focus-visible:ring-2 focus-visible:ring-amber-500/60"
        aria-label="Read: Ehlers Danlos Syndrome: An Overview — Mayo Clinic on Arc Codex (opens in new tab)"
      >
        <div>
          <p className="text-amber-300 font-medium text-sm">
            Ehlers Danlos Syndrome: An Overview — Mayo Clinic
          </p>
          <p className="text-slate-400 text-xs mt-0.5">Arc Codex · A.R.C. analysis included</p>
        </div>
        <ExternalLink
          className="h-4 w-4 text-amber-400/60 group-hover:text-amber-400 transition-colors shrink-0 ml-3"
          aria-hidden="true"
        />
      </a>
    </section>
  );
}

function WatchSection() {
