// Filename: /frontend/app/sources/page.tsx
// Registry of Intelligence — The A.R.C. Source Ledger
// v3.4 Apr 20 2026 — Final Hardened Domain Extraction (Anti-Download Fix)

import React from 'react';
import type { Metadata } from 'next';
import { Globe, ChevronRight, Database, Zap } from 'lucide-react';
import PageWrapper from '@/components/layout/PageWrapper';

export const metadata: Metadata = {
  title: 'Sources // A.R.C. Registry',
  description: 'The global publications and technical feeds powering the Arc Codex.',
};

export const revalidate = 3600;

interface Source {
  name: string;
  url: string;
  category: string;
}

const BACKEND = process.env.BACKEND_INTERNAL_URL ?? process.env.NEXT_PUBLIC_BACKEND_URL ?? 'https://arc-codex.com';

/**
 * Forensic Domain Extractor:
 * Strips all RSS paths and returns ONLY the homepage of the publication.
 * Example: "https://chathamhouse.org/rss/news" -> "https://chathamhouse.org"
 * Example: "https://arxiv.org/rss/physics" -> "https://arxiv.org"
 */
function getPublicationHome(rawUrl: string): string {
  try {
    const url = new URL(rawUrl);
    // Protocol + Hostname is the "Nuclear Option" to prevent XML downloads
    return `${url.protocol}//${url.hostname}`;
  } catch (e) {
    return rawUrl;
  }
}

async function getSources(): Promise<Source[]> {
  try {
    const res = await fetch(`${BACKEND}/api/sources`, { next: { revalidate: 3600 } });
    if (!res.ok) return [];
    return await res.json();
  } catch {
    return [];
  }
}

export default async function SourcesPage() {
  const sources = await getSources();

  const grouped = new Map<string, Source[]>();
  for (const src of sources) {
    const cat = src.category || 'Uncategorized';
    if (!grouped.has(cat)) grouped.set(cat, []);
    grouped.get(cat)!.push(src);
  }
  
  const categories = Array.from(grouped.entries())
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([cat, srcs]) => ({
      name: cat,
      sources: srcs.slice().sort((a, b) => a.name.localeCompare(b.name)),
    }));

  return (
    <PageWrapper>
      <div className="min-h-screen bg-[#fdfbf7] text-slate-900 font-ubuntu selection:bg-slate-900 selection:text-white">
        <main className="max-w-6xl mx-auto px-8 py-24 md:py-40">
          
          <header className="max-w-3xl mb-32 space-y-8 text-left">
            <div className="flex items-center gap-4 text-[10px] font-mono uppercase tracking-[0.5em] text-slate-400">
              <Zap className="h-3 w-3 text-amber-500 fill-amber-500" />
              <span>Ingestion Engine Active</span>
            </div>
            <h1 className="text-6xl md:text-8xl font-bold tracking-tighter leading-none italic text-slate-900">
              The Source <br /> 
              <span className="text-slate-300">Registry.</span>
            </h1>
            <div className="h-px w-24 bg-slate-900" />
            <p className="text-xl md:text-2xl text-slate-500 italic leading-relaxed font-light">
              &ldquo;A comprehensive ledger of {sources.length.toLocaleString()} global publications 
              monitored across {categories.length} analytical categories.&rdquo;
            </p>
          </header>

          <div className="space-y-32">
            {categories.map(({ name, sources: catSources }) => (
              <section key={name} className="group">
                <div className="flex items-end justify-between border-b border-slate-200 pb-4 mb-10">
                  <h2 className="text-sm font-mono uppercase tracking-[0.5em] text-slate-400 font-bold group-hover:text-slate-900 transition-colors">
                    {name}
                  </h2>
                  <div className="flex items-center gap-3 text-slate-300">
                    <Database className="h-3 w-3" />
                    <span className="text-[10px] font-mono">
                      {catSources.length} ASSETS RECORDED
                    </span>
                  </div>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-slate-200 border border-slate-200 overflow-hidden">
                  {catSources.map(src => {
                    const homeUrl = getPublicationHome(src.url);
                    let displayDomain = "Publication";
                    try {
                        displayDomain = new URL(homeUrl).hostname.replace('www.', '');
                    } catch (e) {}

                    return (
                      <a
                        key={src.url}
                        href={homeUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="bg-[#fdfbf7] p-8 hover:bg-white transition-all duration-500 flex flex-col justify-between group/item min-h-[160px]"
                      >
                        <div className="space-y-4">
                          <div className="flex items-center gap-2 opacity-0 group-hover/item:opacity-100 transition-all duration-300 transform -translate-y-2 group-hover/item:translate-y-0">
                            <Globe className="h-3 w-3 text-slate-400" />
                            <span className="text-[8px] font-mono uppercase tracking-widest text-slate-400">Verified Root Domain</span>
                          </div>
                          <h3 className="text-base font-bold italic tracking-tight group-hover/item:text-slate-900">
                            {src.name}
                          </h3>
                        </div>
                        <div className="mt-6 flex items-center gap-2 text-[9px] font-mono uppercase tracking-widest text-slate-300 group-hover/item:text-slate-600 transition-colors">
                          Open {displayDomain} <ChevronRight className="h-2 w-2" />
                        </div>
                      </a>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>

          <footer className="mt-48 pt-12 border-t border-slate-200 opacity-30 text-center space-y-4">
            <p className="text-[10px] font-mono uppercase tracking-[0.8em]">
               A.R.C. INGESTION // {sources.length.toLocaleString()} ACTIVE VOICES
            </p>
            <div className="text-[8px] font-mono uppercase tracking-widest">
              Last Sync: {new Date().toLocaleDateString()} // Fort Collins Node
            </div>
          </footer>
        </main>
      </div>
    </PageWrapper>
  );
}
