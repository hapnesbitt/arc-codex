# =============================================================================
# Arc Codex — Frontend Dockerfile
# Multi-stage build: deps → builder → runner
#
# Stage 1 (deps):    npm ci — cached unless package*.json changes
# Stage 2 (builder): next build — cached unless source changes
# Stage 3 (runner):  Minimal Alpine runtime, standalone output only (~200MB)
#
# Build (context must be project root so backend/directives.json is reachable):
#   docker build -f Dockerfile.frontend -t arc-codex-frontend:latest .
#
# Run standalone:
#   docker run -p 3000:3000 --env-file frontend/.env.local arc-codex-frontend:latest
# =============================================================================

ARG NODE_VERSION=22.16.0

# ── Stage 1: deps ────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --legacy-peer-deps

# ── Stage 2: builder ─────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules

# Copy least-churn to most-churn — maximises layer cache hits.
#
# public/ is deliberately NOT copied here. It is 2.22 GB across 34k files and
# gains ~967 per day (every article hero plus its WebP variants), so having it
# upstream of `npm run build` meant one upload invalidated the compile. Next's
# standalone output never includes public/ anyway — the runner stage takes it
# straight from the build context. The builder needs exactly one file out of
# it: /wiki reads public/directives.json during static generation.
COPY frontend/next.config.mjs frontend/tsconfig.json frontend/tailwind.config.mjs frontend/postcss.config.js ./
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
COPY frontend/app         ./app
COPY frontend/components  ./components
COPY frontend/lib         ./lib
COPY backend/directives.json ./public/directives.json

# NEXT_PUBLIC_* vars must be present at build time
ARG NEXTAUTH_URL
ENV NEXTAUTH_URL=${NEXTAUTH_URL}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN npm run build

# ── Stage 3: runner ──────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=""

# Non-root user — security best practice
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Standalone output + static assets only — no node_modules, no source.
# public/ comes from the build context rather than the builder stage, so an
# upload only ever invalidates layers below this line — never the compile.
COPY frontend/public                               ./public
COPY backend/directives.json                       ./public/directives.json
# Defensive: ensure all public/ files are world-readable so the nextjs user
# (uid 1001) can serve them. Without this, a host-side mode 600 file (the
# kind umask-restrictive editors create) gets baked in and Next.js returns
# 500. Mirrors the fix landed on Huntaegis.
#
# Scoped to files that actually lack the bit. `chmod -R` touched all 34k
# every build and cost 218s (measured 2026-07-23) to change nothing — the
# host tree has zero offenders. This form costs 0.7s and still catches one.
RUN find ./public ! -perm -o+r -exec chmod a+rX {} + || true
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static     ./.next/static

USER nextjs
EXPOSE 3000

# next.js standalone generates server.js — replaces `npm run start`
CMD ["node", "server.js"]
