[Unit]
Description=Arc Codex audio narration (sliding-window daemon on warden)
Documentation=file:///home/www/arc_stack/TODO.md
# The Redis tunnel must be up first — the daemon connects to
# 127.0.0.1:6379 which is arc-redis-tunnel.service's forward.
After=network-online.target arc-redis-tunnel.service
Wants=network-online.target arc-redis-tunnel.service

[Service]
Type=exec
WorkingDirectory=/home/www/arc_stack/backend
# Kokoro venv: reuses the existing, already-tested install at
# /home/ross/.venv (kokoro 0.9.4 + torch + spacy model + Kokoro-82M weights
# already warmed — confirmed working, real synthesis already run there) —
# not a fresh /opt/kokoro/venv build. See AUDIO_KOKORO_PYTHON's own
# comment in scribe.py for why this is an env override now, not a
# hardcoded lecture_pipeline path.
Environment=AUDIO_KOKORO_PYTHON=/home/ross/.venv/bin/python
# Push-per-file sync: each finished mp3 is rsync'd to resolute before
# audio_url is committed on the article. rrsync -wo chroots the destination
# to /home/www/arc_stack/frontend/public/uploads/audio; the dedicated key
# has restrict + command="/usr/bin/rrsync -wo …" in resolute's authorized_keys.
Environment=ARC_AUDIO_SYNC_DEST=ross@192.168.1.198:.
Environment=ARC_AUDIO_SYNC_SSH_KEY=%h/.ssh/arc_audio_sync_ed25519
# Route broadcast-script generation at warden's OWN local Ollama, not the
# stack default (spectre :189). 2026-09-18: spectre's num_parallel=2 slots
# were saturated by pre_analyze's concurrency-of-8, so every warden call to
# 189/api/generate queued indefinitely and timed out at the 900s read
# limit — measured live 2026-09-17 with zero ✓ narrations produced in the
# first ~16 minutes after the newest-first redesign shipped. Warden has
# 22 GiB RAM, gemma4:e2b already pulled locally, load < 0.1 idle; a
# trivial /api/generate returns from a cold-model load in ~7.6s. Removes
# both the queue contention and the network hop.
Environment=BROADCAST_OLLAMA_HOST=http://localhost:11434
Environment=BROADCAST_OLLAMA_MODEL=gemma4:e2b
ExecStart=/home/www/arc_stack/backend/venv/bin/python /home/www/arc_stack/backend/audio_backfill.py
# Same restart discipline as spectre's unit:
#   Restart=always because the daemon's docstring explicitly designs for it
#   ("A process with no position to lose doesn't need to save one" — restart
#   just re-reads Redis and continues), and RestartSteps for backoff against
#   crash loops (a tight loop against Kokoro is worth damping harder than a
#   watchdog poll loop).
Restart=always
RestartSec=5s
RestartMaxDelaySec=60s
RestartSteps=5

[Install]
WantedBy=default.target
