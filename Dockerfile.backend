# =============================================================================
# Arc Codex — Backend Base Dockerfile
# Shared by all Python backend services: gunicorn, scribe, analyzer,
# stream_consumer, manual_publisher, mailer.
#
# Each service overrides CMD at the compose level — no per-service Dockerfile
# needed as long as they share the same venv/requirements.
#
# Build:
#   docker build -f Dockerfile.backend -t arc-codex-backend:latest ./backend
#
# Individual service example:
#   docker run arc-codex-backend:latest python3 scribe.py
# =============================================================================

FROM python:3.11-slim AS base

# System deps — Playwright needs these; trim if not using Playwright in container
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Stage: deps ──────────────────────────────────────────────────────────────
# Separate layer so pip install is cached unless requirements.txt changes
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright browsers if scribe uses them
# Comment out if Playwright runs on the MacBook Air M1 only
# RUN playwright install chromium --with-deps

# ── Stage: source ─────────────────────────────────────────────────────────────
COPY . .

# Runtime environment — override in docker-compose or .env
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Default: gunicorn. Overridden per-service in docker-compose.yml
CMD ["./gunicorn_arc.sh"]
