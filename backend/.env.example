# Arc Codex — backend environment template
# Copy this file to .env and fill in real values. .env is gitignored.
# NEVER commit real secrets to this file — placeholders only.

# --- Redis ---
# Use the same password in REDIS_URL and REDIS_PASSWORD. Must match
# /etc/redis/redis.conf `requirepass`. Set REDIS_PASSWORD via a strong
# random value (e.g. `openssl rand -base64 24 | tr -d /+=`).
REDIS_URL="redis://:CHANGE_ME@localhost:6379/0"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# --- Solr ---
SCRIBE_SOLR_URL=http://localhost:8983/solr/arc-codex

# --- Ollama (AI inference) ---
OLLAMA_URL=http://192.168.1.185:11434
OLLAMA_CLOUD_MODEL=gpt-oss:20b-cloud
OLLAMA_LOCAL_FALLBACK=mistral:7b
TRANSLATION_MODEL=MedAIBase/TranslateGemma:4b

# --- Local-only deployment posture (optional) ---
# Set to 1 for a buyer who requires zero cloud dependency. When enabled:
#   - is_cloud_available() returns False regardless of the circuit breaker
#   - is_cloud_reachable() returns False without touching the network
#   - analyzer escalation, translation cloud-retry, and every future
#     call_ollama_with_fallback caller degrade to local
#   - site_config.py's loader refuses to start if [inference].council_url
#     points off-host (character_builder.py's council path doesn't route
#     through ollama_utils and would otherwise bypass the mode)
# Unset OLLAMA_CLOUD_MODEL alongside to remove the ambiguity — otherwise
# the module logs a WARN at import that the cloud-model env is inert.
# ARC_LOCAL_ONLY=1

# --- Library publication ---
# arc.sh creates and synchronizes LIBRARY_REVALIDATE_SECRET between the
# ignored backend/.env and frontend/.env.local files. Do not commit it.
LIBRARY_REVALIDATE_URL=http://127.0.0.1:3000/api/internal/revalidate-library
# Optional override; the default lock is /home/www/arc_stack/pids/library_fetcher.lock.
# LIBRARY_REFRESH_LOCK_PATH=/home/www/arc_stack/pids/library_fetcher.lock

# --- Social posting (optional) ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=
