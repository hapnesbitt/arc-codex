# Ignore Python artifacts
__pycache__/
*.py[cod]

# Ignore Node.js artifacts
node_modules/

# Ignore environment variables/secrets (CRITICAL)
backend/.env
frontend/.env.local
.env

# Ignore logs and backups
logs/
backups/

# Ignore system-specific files
.DS_Store

# Ignore pids and secrets
pids/
secret/

# Ignore Next.js build/cache artifacts
frontend/.next/

# Ignore the production deployment directory
/mnt/data/www/arc_stack_prod/

# Upload processing artifacts
backend/upload/

# Manual backup snapshots
*.Mar*
*.Feb*

# Docker experiment artifacts
DOCKERENV
arc1.sh
arc_backup_*.tar.gz
files.zip
frontend/files.zip
**/*.mp3
secret/
foo
*.swp

# Article cover image uploads (user-generated, not source-controlled)
# Default fallback image is the only file tracked in git here.
frontend/public/uploads/*
!frontend/public/uploads/arc-codex-default.jpg
!frontend/public/uploads/arc-codex-manual.jpg

# Hourly auto-generated by sync_intel.sh
frontend/public/sitemap.xml
frontend/public/news-sitemap.xml
frontend/public/rss.xml

# Next.js build cache
frontend/tsconfig.tsbuildinfo

# Local edit backups (.May06, .May07, .Apr20, .Mar27, etc.)
*.May[0-9]*
*.Apr[0-9]*
*.Mar[0-9]*
*.beforelib
*.Oops

# Python virtual environment
backend/venv/
__pycache__/
*.pyc

# Local timestamped backups / superseded drafts
*.bak*
Jun17*
*.Jun[0-9]*

# SQLite runtime artifact (Gutenberg library corpus, lives on /mnt/arcdata in prod)
backend/library.db

# Stray generator output — the real sitemap is frontend/public/sitemap.xml (hourly, ignored above)
/sitemap.xml
