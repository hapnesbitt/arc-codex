{
  "title": "Arc Codex — Corpus Intelligence",
  "uid": "arc-corpus-v1",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "1h",
  "time": { "from": "now-7d", "to": "now" },
  "timezone": "browser",
  "tags": ["arc-codex", "corpus", "epistemic"],
  "panels": [

    {
      "id": 1,
      "title": "Total Articles",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "arc_corpus_total",
          "legendFormat": "Articles",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 2,
      "title": "Avg Chimera Score",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "green",  "value": 0.6 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "arc_chimera_score_avg",
          "legendFormat": "Chimera Avg",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 3,
      "title": "SYNTHETIC %",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 25 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "arc_synthetic_pct",
          "legendFormat": "Synthetic %",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 4,
      "title": "Analysis Coverage (Purple Team %)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green",  "value": 80 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "arc_completeness{field=\"purple_team_analysis\"}",
          "legendFormat": "Purple Team",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 5,
      "title": "Last Scrape",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        }
      },
      "targets": [
        {
          "expr": "arc_exporter_last_scrape_timestamp * 1000",
          "legendFormat": "Last Scrape",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 6,
      "title": "Scrape Duration (sec)",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        }
      },
      "targets": [
        {
          "expr": "arc_exporter_scrape_duration_sec",
          "legendFormat": "Duration",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 10,
      "title": "Chimera Score Distribution",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "arc_chimera_bucket",
          "legendFormat": "{{bucket}}",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 11,
      "title": "Sentinel Verdict Breakdown",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "HUMAN" },     "properties": [{ "id": "color", "value": { "fixedColor": "green",  "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "UNCERTAIN" },  "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "SYNTHETIC" },  "properties": [{ "id": "color", "value": { "fixedColor": "red",    "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "(NONE)" },     "properties": [{ "id": "color", "value": { "fixedColor": "gray",   "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "expr": "arc_sentinel_total",
          "legendFormat": "{{verdict}}",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 12,
      "title": "Directive Breakdown",
      "type": "piechart",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "pie",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "arc_directive_total",
          "legendFormat": "{{directive}}",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 20,
      "title": "Chimera Score — Average Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "arc_chimera_score_avg",
          "legendFormat": "Avg Chimera",
          "datasource": "Prometheus"
        },
        {
          "expr": "arc_chimera_score_high_total / arc_corpus_scored_total",
          "legendFormat": "High Score Ratio (≥0.7)",
          "datasource": "Prometheus"
        },
        {
          "expr": "arc_chimera_score_low_total / arc_corpus_scored_total",
          "legendFormat": "Low Score Ratio (<0.3)",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 21,
      "title": "Corpus Size & SYNTHETIC % Over Time",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SYNTHETIC %" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "percent" }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "arc_corpus_total",
          "legendFormat": "Total Articles",
          "datasource": "Prometheus"
        },
        {
          "expr": "arc_synthetic_pct",
          "legendFormat": "SYNTHETIC %",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 30,
      "title": "Top Sources",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 10 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "topk(20, arc_source_total)",
          "legendFormat": "{{domain}}",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 31,
      "title": "Corpus Completeness",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 10 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green",  "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "arc_completeness",
          "legendFormat": "{{field}}",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 40,
      "title": "A.R.C. Pattern Frequency (Top 20)",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 10 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "topk(20, arc_arc_pattern_total > 0)",
          "legendFormat": "{{code}} {{name}}",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 41,
      "title": "Language Breakdown",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 40, "w": 8, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "pie",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "arc_language_total",
          "legendFormat": "{{lang}}",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 42,
      "title": "Divisive Articles (<0.3) Over Time",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 40, "w": 16, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "arc_chimera_score_low_total",
          "legendFormat": "Divisive Articles (<0.3)",
          "datasource": "Prometheus"
        },
        {
          "expr": "arc_chimera_score_high_total",
          "legendFormat": "Objective Articles (≥0.7)",
          "datasource": "Prometheus"
        }
      ]
    }

  ]
}
