# Dependencies
frontend/node_modules
backend/venv

# Runtime environment and secret files. The repository root is the Docker
# build context, so ignored Git files must also be excluded here. Keep only
# non-secret examples/templates available to Dockerfiles and documentation.
**/.env
**/.env.*
**/*.env
**/*.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
!**/*.env.example
!**/*.env.sample
!**/*.env.template

# Build output
frontend/.next

# Uploads — bind-mounted from the host at runtime (docker-compose.yml), never
# baked in. 2.1 GB / 34k files that next build does not read; keeping them out
# of the context also keeps them out of the image layer and the export.
frontend/public/uploads

# Logs and runtime
logs/
pids/
*.log
*.log.gz

# Backups
backups/

# Git
.git
.gitignore

# Dev
.claude
*.swp
*.swo

# Upload completed/failed (large, not needed for build)
backend/upload/completed
backend/upload/failed
